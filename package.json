{
  "name": "pixel-agents",
  "description": "Pixel art office where your Claude Code agents come to life as animated characters",
  "version": "1.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/pablodelucca/pixel-agents"
  },
  "license": "MIT",
  "scripts": {
    "postinstall": "cd webview-ui && npm install --no-audit --no-fund",
    "install:webview": "cd webview-ui && npm install --no-audit --no-fund",
    "build:webview": "npm run install:webview && cd webview-ui && npm run build",
    "build:server": "node esbuild-standalone.js",
    "build": "node esbuild-standalone.js && npm run build:webview",
    "build:prod": "node esbuild-standalone.js --production && npm run build:webview",
    "check-types": "tsc --noEmit",
    "lint": "eslint src standalone",
    "start": "node dist/standalone.js --no-local-dev",
    "start:local": "node dist/standalone.js",
    "import-tileset": "tsx scripts/import-tileset-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@types/node": "25.x",
    "@types/pg": "^8.20.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.0",
    "npm-run-all": "^4.1.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "ws": "^8.19.0"
  }
}
